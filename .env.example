# Salin menjadi .env.local untuk lokal. Jangan isi secret di HTML/JS publik.
SUPABASE_URL=https://PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Buat random 32-byte (lihat docs/reviews-setup.md).
ABUSE_HASH_SECRET=
# Daftar origin lengkap, pisahkan koma. Tanpa slash akhir/wildcard.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Daftar hostname Turnstile, tanpa protokol/port.
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
# Tetap false sampai migrasi dan konfigurasi selesai.
REVIEWS_ENABLED=false
